# Copy this file to `.env` (same directory as manage.py) and adjust values
# for your environment. `.env` is loaded automatically on startup via
# python-dotenv (see hotel_marketplace/settings.py) and is already
# git-ignored. None of these are required for local/demo use -- safe
# defaults are baked into settings.py.

# --- Core Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- REST API ---
API_PAGE_SIZE=10

# --- Email (defaults to printing to the console; set these for real SMTP delivery) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@hotellease.demo
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True

# --- Database (required — the app now connects to PostgreSQL) ---
DB_NAME=hotel_marketplace
DB_USER=hotel_marketplace
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
